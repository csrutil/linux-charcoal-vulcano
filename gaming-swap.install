post_install() {
  /usr/lib/gaming-swap/configure
}

pre_upgrade() {
  # Older packages shipped NAP and enabled its units. Disable them while the
  # old helper is still installed, before pacman removes the unit files.
  if [ -x /usr/lib/nap/configure-services ]; then
    /usr/lib/nap/configure-services remove || true
  fi
}

post_upgrade() {
  post_install
}
